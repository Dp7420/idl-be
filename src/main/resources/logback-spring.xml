<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %5p --- [%thread] CORRELATION_ID=%X{CorrelationId} EVENT_NAME=%X{EVENT_NAME} EVENT_ID=%X{EVENT_ID} EVENT_DESCRIPTION=%X{EVENT_DESCRIPTION} SERVICE_NAME=%X{SERVICE_NAME} %logger{40} : %msg%n"/>

    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
        </encoder>

    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>